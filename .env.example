# ============================================================================
# Bora Piauí — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores do seu ambiente.
#   cp .env.example .env
#
# O `.env` REAL NUNCA deve ser commitado (já está no .gitignore).
# Referências de validação: server/_core/env.ts (validateEnv) e server/_core/url.ts.
# ============================================================================

# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------

# Ambiente de execução: "development" | "production".
# Efeitos no sistema:
#   - validateEnv(): em produção exige JWT_SECRET com 32+ caracteres;
#   - externalUrl(): em produção os schemas Zod aceitam SOMENTE URLs https:
#     (http: fica liberado apenas fora de produção);
#   - server/_core/index.ts: desenvolvimento usa Vite; produção serve estáticos;
#   - URLs externas cadastradas (fontes/rotas) passam a exigir https: em produção.
NODE_ENV=development

# Porta preferida do servidor (se ocupada, as próximas 20 são testadas).
PORT=3000

# ----------------------------------------------------------------------------
# Banco de dados (MySQL / TiDB compatível)
# ----------------------------------------------------------------------------

# OBRIGATÓRIA para: servidor, drizzle-kit (generate/migrate) e seed.
# Sem ela o boot não conecta (getDb retorna null) e `pnpm db:push` falha.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#   - Em produção prefira conexão criptografada (TLS) oferecida pelo provedor;
#   - O seed (`pnpm db:seed`) só roda depois das migrations (`pnpm db:push`);
#   - Use um banco de staging distinto para homologação antes do corte final.
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/bora_piaui

# ----------------------------------------------------------------------------
# Sessão e autenticação (OAuth + JWT HS256)
# ----------------------------------------------------------------------------

# Segredo de assinatura/verificação dos cookies de sessão (algoritmo HS256, jose).
# REGRAS DE VALIDAÇÃO (fail-fast no boot — server/_core/env.ts):
#   - OBRIGATÓRIO em TODOS os ambientes: boot aborta se ausente ou vazio;
#   - EM PRODUÇÃO: mínimo de 32 caracteres (recomendado 48+).
# Sugestão de geração:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres

# URL base do provedor OAuth usado pelo login (sdk.ts faz o exchange de tokens).
# Exemplo: https://oauth.provedor.exemplo
OAUTH_SERVER_URL=

# ID da aplicação registrado no provedor OAuth (enviado como clientId).
VITE_APP_ID=

# openId que recebe automaticamente a role "admin" ao fazer login
# (server/db.ts upsertUser). Deixe vazio em desenvolvimento se não precisar
# de painel administrativo; em produção defina o openId do responsável.
OWNER_OPEN_ID=

# ----------------------------------------------------------------------------
# Integrações internas opcionais (Forge: LLM, imagem, transcrição)
# ----------------------------------------------------------------------------

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ----------------------------------------------------------------------------
# Scripts de validação E2E (Playwright em scripts/)
# ----------------------------------------------------------------------------

# URL base usada por scripts/validate-*.mjs (default: http://127.0.0.1:3000/).
# Observação: os scripts administrativos exigem sessão com usuário role=admin.
BORA_PIAUI_URL=http://127.0.0.1:3000/
